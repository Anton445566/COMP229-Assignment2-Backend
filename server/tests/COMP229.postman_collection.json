{
  "info": {
    "name": "COMP229 Assignment 2 Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Set baseUrl, email, password, and record IDs locally. Sign-in uses securely hashed users; legacy plaintext users cannot sign in. Only explicitly configured PORTFOLIO_ADMIN_IDS users can bulk-delete. PUT and resource POST tests are blocked unless allowWriteTests is true. All DELETE tests are blocked unless allowDestructiveTests is true. Never enable destructive tests against existing portfolio records; use an isolated disposable database. Sign-out discards the local token; a copied JWT remains valid until its one-hour expiry. The confirmed qualification ID is 6ace9116f39bfd9e9f4fc3e8."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "signupPassword",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "contactId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "projectId",
      "value": ""
    },
    {
      "key": "qualificationId",
      "value": "6ace9116f39bfd9e9f4fc3e8"
    },
    {
      "key": "allowWriteTests",
      "value": "false"
    },
    {
      "key": "allowDestructiveTests",
      "value": "false"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const method = pm.request.method;",
          "const path = pm.request.url.toString();",
          "const destructive = method === 'DELETE';",
          "const resourceWrite = /\\/api\\//.test(path) && ['POST', 'PUT', 'PATCH'].includes(method);",
          "const blocked = destructive ? pm.variables.get('allowDestructiveTests') !== 'true' : resourceWrite && pm.variables.get('allowWriteTests') !== 'true';",
          "if (blocked) {",
          "  console.warn('Skipped: write/destructive tests require explicit opt-in and an isolated disposable database.');",
          "  pm.execution.skipRequest();",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Sign in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/signin",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected status 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('token', body.token);",
                  "  pm.test('Safe authenticated user', function () { pm.expect(body.user).not.to.have.property('hashed_password'); pm.expect(body.user).not.to.have.property('salt'); });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
